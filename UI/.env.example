# Copy this file to .env for local dev, or set VITE_API_URL as an
# Environment Variable in the Vercel project settings for production.
#
# Local dev (SERVER running on its default port):
# VITE_API_URL=http://localhost:8000
#
# Production (your deployed backend URL, no trailing slash):
# VITE_API_URL=https://sims-api.onrender.com
VITE_API_URL=http://localhost:8000