# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sims?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/sims?retryWrites=true&w=majority

# Any long random string - used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the Express server listens on.
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:3000

# --- Owner seeding (run `npm run seed` once) -------------------------------
# This system supports exactly one owner account. Public owner registration
# is disabled; instead set these and run `npm run seed` to create (or
# update) that single owner. Change OWNER_PASSWORD after seeding if you like
# - the owner can update it from within the app once logged in.
OWNER_FULLNAMES=System Owner
OWNER_EMAIL=owner@yourcompany.com
OWNER_PHONE=
OWNER_PASSWORD=change-this-strong-password
